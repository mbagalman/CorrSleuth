# Python bytecode and test caches
__pycache__/
*.py[cod]
.pytest_cache/
.hypothesis/
.mypy_cache/
.ruff_cache/

# Coverage artifacts
.coverage
.coverage.*
coverage.xml
htmlcov/

# Build and packaging artifacts
build/
dist/
*.egg-info/

# Virtual environments
.venv/
venv/
env/

# Internal review/audit notes (not shipped or published) — matched in any
# directory (docs/, docs/archive/, etc.), not just the docs/ root. Covers both
# naming conventions used so far: `code-review-*.md` and `*-review-*.md`
# (e.g. methodology-review-statistician.md, code-review-4-statistics-thorough.md).
code-review-*.md
*-review-*.md

# Local-only reference material and working folders (not shipped or published)
docs/references/
/user-testing/

# Local-only planning / proposal notes (not shipped; promoted into tracked
# ticket packs only once accepted).
docs/development/proposed-diagnostics-tickets.md

# Local editor and OS files
.idea/
.vscode/
.claude/
.DS_Store
Thumbs.db
